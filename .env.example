# Optional. `docker compose up` needs none of this: every value below has a
# default, and the database password and the initialisation code are generated
# by the `secrets` service into a volume that the others read.
#
# Copy to .env only to override something — a published port, a public origin,
# a log level.

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=laysi
POSTGRES_DB=laysi
# Generated by the secrets service into /secrets/pg_password. Setting it here
# has no effect; postgres reads POSTGRES_PASSWORD_FILE.

# RustFS object storage
# Document files really are stored here; the database keeps only the object key,
# size, MIME type and BLAKE3 hash. The same credentials are used by rustfs
# itself and by api to access the files.
RUSTFS_ACCESS_KEY=laysi
# The one credential compose still interpolates: RustFS reads it from the
# environment at startup and has no file form. What keeps this bucket closed is
# that neither 9000 nor 9001 is published.
RUSTFS_SECRET_KEY=laysi-object-store
# Bucket name. Created by api at startup when it does not exist.
RUSTFS_BUCKET=laysi-documents

# Browser login and CORS
# Session timeouts are set on 「基礎設定」, and the Secure flag on the session
# cookie follows X-Forwarded-Proto rather than a setting.
#
# CORS only matters to the Vite dev server: in the compose deployment the
# frontend is same-origin behind the web container and no CORS header is
# involved. A credentialed cross-origin request needs one explicit origin;
# * is invalid.
CORS_ALLOWED_ORIGIN=http://localhost:5173

# ── First-run initialisation ────────────────────────────────────────────────
# The first account can be created in the browser, at the address the frontend
# is served from. That page appears only while the installation has no account
# at all and never again afterwards; there is no way to reopen it.
#
# false makes the endpoint refuse regardless, leaving `laysi-admin create-user`
# on the host as the only way in.
SETUP_ALLOW_WEB=true
# Without it, anyone who reaches the address before you do can claim the
# installation. Generated by the secrets service, which prints it on first
# start (`docker compose logs secrets`), and read from
# /secrets/setup_token. Setting it here has no effect.

# External sign-in (Google Workspace, Cloud Identity, any OpenID Connect IdP)
# Not configured here. The issuer, client id, client secret, allowed domain
# and whether a first sign-in creates its own account are set on the security
# screen by a system administrator, and take effect without a restart.

# ── MCP ─────────────────────────────────────────────────────────────────────
# MCP bearer credentials are issued by the issue_api_token operation, and the
# database keeps only a BLAKE3 hash. There is no shared environment variable;
# every token binds its own actor and actor_role.
#
# /mcp is served by the separate mcp service (LAYSI_SERVE=mcp), the only backend
# port compose publishes. AI connectors (Claude Code, the desktop app) connect
# to it directly, bypassing the web nginx. Because it is exposed, put TLS and a
# domain behind a reverse proxy of your choice (Caddy, Traefik, nginx). None is
# bundled, and publishing this port without one is not recommended.
MCP_PORT=8089
# The per-token call limit is set on 「基礎設定」.
# Comma-separated Origin allow list, guarding against browser DNS rebinding.
# Empty accepts only callers that send no Origin header, which normal AI
# connectors do not.
MCP_ALLOWED_ORIGINS=

# Other
# Published port of the frontend.
WEB_PORT=8088
RUST_LOG=info,sqlx=warn
