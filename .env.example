# Copy to .env and edit. Compose refuses to start when a value marked required
# is unset, which is safer than booting with a default password.

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=laysi
POSTGRES_DB=laysi
# Required.
POSTGRES_PASSWORD=請改成一個長而隨機的密碼

# RustFS object storage
# Document files really are stored here; the database keeps only the object key,
# size, MIME type and BLAKE3 hash. The same credentials are used by rustfs
# itself and by api to access the files.
RUSTFS_ACCESS_KEY=laysi
# Required.
RUSTFS_SECRET_KEY=請改成一個長而隨機的密鑰
# Bucket name. Created by api at startup when it does not exist.
RUSTFS_BUCKET=laysi-documents

# Browser login and CORS
# false for local HTTP development; must be true on production HTTPS.
SESSION_COOKIE_SECURE=false
# Idle timeout. Every successful use updates last_seen_at.
SESSION_IDLE_MINUTES=60
# Absolute lifetime from creation, regardless of continued use.
SESSION_ABSOLUTE_HOURS=168
# A credentialed cross-origin request needs one explicit origin; * is invalid.
CORS_ALLOWED_ORIGIN=http://localhost:5173

# OpenID Connect (optional)
# Enabled only when all four are set; with none or only some, the OAuth
# endpoints return 404. The issuer is resolved through discovery for its
# endpoints and JWKS, so no specific IdP is assumed.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Example for local compose, returning to the API through the web proxy:
# OIDC_REDIRECT_URL=http://localhost:8088/v1/auth/oauth/callback
OIDC_REDIRECT_URL=

# ── MCP ─────────────────────────────────────────────────────────────────────
# MCP bearer credentials are issued by the issue_api_token operation, and the
# database keeps only a BLAKE3 hash. There is no shared environment variable;
# every token binds its own actor and actor_role.
#
# /mcp is served by the separate mcp service (LAYSI_SERVE=mcp), the only backend
# port compose publishes. AI connectors (Claude Code, the desktop app) connect
# to it directly, bypassing the web nginx. Because it is exposed, put TLS and a
# domain behind a reverse proxy of your choice (Caddy, Traefik, nginx). None is
# bundled, and publishing this port without one is not recommended.
MCP_PORT=8089
# Maximum calls per token per minute; 0 means unlimited.
MCP_RATE_LIMIT_PER_MINUTE=60
# Comma-separated Origin allow list, guarding against browser DNS rebinding.
# Empty accepts only callers that send no Origin header, which normal AI
# connectors do not.
MCP_ALLOWED_ORIGINS=

# Other
# Published port of the frontend.
WEB_PORT=8088
RUST_LOG=info,sqlx=warn
