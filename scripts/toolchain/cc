#!/bin/sh
# A C compiler and linker driver backed by zig, for machines with no system
# `cc`. Put this directory on PATH and cargo, cc-rs and rustc all find it by
# the name they already look for, so no cargo config or environment variable
# is needed — and nothing here reaches the Docker build, which uses the rust
# image's own toolchain.
#
# The translation is the reason this is a script and not a symlink: cc-rs
# passes Rust's target triple, and zig names the same target without the
# vendor field.
for a in "$@"; do
  case "$a" in
    --target=x86_64-unknown-linux-gnu) set -- "$@" "--target=x86_64-linux-gnu" ;;
    --target=aarch64-unknown-linux-gnu) set -- "$@" "--target=aarch64-linux-gnu" ;;
    *) set -- "$@" "$a" ;;
  esac
  shift
done
exec "${ZIG:-zig}" cc "$@"
